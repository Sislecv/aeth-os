#!/usr/bin/env bash
# ==============================================================================
# AgenticOS: Zen Focus Mode Toggle (Super+F11)
#
# Toggles GNOME Do Not Disturb (DND), hides/restores the GNOME Shell top panel,
# toggles full-screen focus, and triggers low-disturbance audio feedback.
# ==============================================================================
set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/agentic-zen-state"

is_zen_active() {
    if [[ -f "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" == "active" ]]; then
        return 0
    fi
    # Fallback inspection of GNOME desktop notification banner status
    if command -v gsettings >/dev/null 2>&1; then
        local banner_status
        banner_status=$(gsettings get org.gnome.desktop.notifications show-banners 2>/dev/null || echo "true")
        if [[ "$banner_status" == "false" ]]; then
            return 0
        fi
    fi
    return 1
}

enter_zen() {
    # 1. Subtle audio feedback (Libcanberra)
    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -i message-new-instant -d "Zen Mode Activated" 2>/dev/null || true
    fi

    # 2. Briefly notify user before silencing notification banners
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 1500 -a "AgenticOS" -i "starred" "Zen Mode Activated" "Notifications silenced, focus engaged." 2>/dev/null || true
        sleep 0.15
    fi

    # 3. Enable Do Not Disturb (silence all notification banners)
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.notifications show-banners false 2>/dev/null || true
    fi

    # 4. Hide GNOME Shell top panel if Shell D-Bus interface is accessible
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
            --method org.gnome.Shell.Eval "if (typeof Main !== 'undefined' && Main.panel) { Main.panel.hide(); }" >/dev/null 2>&1 || true
    fi

    # 5. Toggle active window full-screen focus via Wayland keystroke injection (wtype)
    if command -v wtype >/dev/null 2>&1; then
        wtype -k F11 2>/dev/null || true
    fi

    echo "active" > "$STATE_FILE"
}

exit_zen() {
    # 1. Restore notification banners
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.notifications show-banners true 2>/dev/null || true
    fi

    # 2. Restore GNOME Shell top panel
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
            --method org.gnome.Shell.Eval "if (typeof Main !== 'undefined' && Main.panel) { Main.panel.show(); }" >/dev/null 2>&1 || true
    fi

    # 3. Restore window from full-screen focus
    if command -v wtype >/dev/null 2>&1; then
        wtype -k F11 2>/dev/null || true
    fi

    # 4. Subtle audio feedback
    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -i bell -d "Zen Mode Deactivated" 2>/dev/null || true
    fi

    # 5. Notify user of restored desktop
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 1500 -a "AgenticOS" -i "preferences-desktop" "Zen Mode Deactivated" "Normal workspace restored." 2>/dev/null || true
    fi

    echo "inactive" > "$STATE_FILE"
}

show_status() {
    if is_zen_active; then
        echo "active"
        return 0
    else
        echo "inactive"
        return 1
    fi
}

# Command line parsing
ACTION="${1:---toggle}"

case "$ACTION" in
    --on|enable|start)
        enter_zen
        ;;
    --off|disable|stop)
        exit_zen
        ;;
    --status)
        show_status
        ;;
    --toggle)
        if is_zen_active; then
            exit_zen
        else
            enter_zen
        fi
        ;;
    -h|--help)
        echo "Usage: agentic-zen-toggle [--toggle | --on | --off | --status]"
        echo "Toggles GNOME Do Not Disturb, top panel visibility, and full-screen focus."
        exit 0
        ;;
    *)
        echo "Unknown option: $ACTION" >&2
        echo "Usage: agentic-zen-toggle [--toggle | --on | --off | --status]" >&2
        exit 1
        ;;
esac
