#!/usr/bin/env bash
# /usr/local/bin/agentic-terminal
# AgenticOS Terminal Companion Wrapper
# Launches or attaches to the Zellij companion session with the 65:35 layout.

set -euo pipefail

VERSION="1.0.0"
SESSION_NAME="agentic"
DEFAULT_LAYOUT="/etc/zellij/agentic.kdl"
LAYOUT="$DEFAULT_LAYOUT"
CUSTOM_LAYOUT_SET=false
DRY_RUN=false
STATUS_CHECK=false
FORCE_NEW=false
KILL_SESSION=false
LIST_SESSIONS=false
JSON_OUTPUT=false

# ANSI color codes
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() {
    if [ "$JSON_OUTPUT" = false ]; then
        echo -e "${BLUE}[agentic-terminal]${NC} $1" >&2
    fi
}

log_warn() {
    if [ "$JSON_OUTPUT" = false ]; then
        echo -e "${YELLOW}[agentic-terminal:warn]${NC} $1" >&2
    fi
}

log_error() {
    if [ "$JSON_OUTPUT" = false ]; then
        echo -e "${RED}[agentic-terminal:error]${NC} $1" >&2
    fi
}

show_help() {
    local prog_name
    prog_name="$(basename "${BASH_SOURCE[0]}")"
    cat <<EOF
Aeth OS Terminal Companion Wrapper (${prog_name})
Launches or attaches to the Zellij companion terminal with 65:35 dual-pane layout.

Usage:
  ${prog_name} [OPTIONS]

Options:
  -h, --help               Show this help message and exit
  -v, --version            Display version information
  --status                 Check if session is active (exit 0 if active, 1 if not)
  --dry-run                Print command that would be executed without running it
  --json                   Format output as JSON (for --status and --dry-run)
  -s, --session NAME       Zellij session name (default: agentic)
  -l, --layout PATH        Zellij layout file (default: /etc/zellij/agentic.kdl)
  -n, --new                Force create a new session instead of attaching
  -k, --kill               Kill the target Zellij session
  --list                   List all active Zellij sessions

Keybindings inside Agentic Companion:
  [Alt+A: Send Command]      Send command line to Pi Agent companion
  [Alt+B: Send Logs]         Capture and send last 50 lines of logs to Pi Agent companion
  [Alt+C: Ghost Computer]    Call Computer Use Agent on Ghost Workspace (Workspace 2)
  [F5: Voice Input]          Speech-to-text voice dictation (via Blurt / whisper.cpp)
EOF
}

show_version() {
    local prog_name
    prog_name="$(basename "${BASH_SOURCE[0]}")"
    echo "${prog_name} ${VERSION} (Aeth OS)"
}

# Resolve layout file path with fallback to relative repository paths if in dev tree
resolve_layout_path() {
    if [ "$CUSTOM_LAYOUT_SET" = true ]; then
        return 0
    fi
    if [ -f "$LAYOUT" ]; then
        return 0
    fi

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
    if [ -n "$script_dir" ]; then
        # Check 3 levels up: matches /usr/local/bin -> /etc and
        # config/includes.chroot/usr/local/bin -> config/includes.chroot/etc
        if [ -f "$script_dir/../../../etc/zellij/agentic.kdl" ]; then
            LAYOUT="$(cd "$script_dir/../../../etc/zellij" && pwd)/agentic.kdl"
            return 0
        fi
        # Check 5 levels up: relative to repository root from config/includes.chroot/usr/local/bin
        if [ -f "$script_dir/../../../../../config/includes.chroot/etc/zellij/agentic.kdl" ]; then
            LAYOUT="$(cd "$script_dir/../../../../../config/includes.chroot/etc/zellij" && pwd)/agentic.kdl"
            return 0
        fi
    fi

    # Fallback to default
    LAYOUT="$DEFAULT_LAYOUT"
}

# Check whether target Zellij session is currently active/running
is_session_running() {
    local target="$1"
    if ! command -v zellij >/dev/null 2>&1; then
        return 1
    fi
    # Zellij list-sessions outputs session names at start of line
    if zellij list-sessions 2>/dev/null | grep -E "^${target}([[:space:]]|$)" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --status)
            STATUS_CHECK=true
            shift
            ;;
        --json)
            JSON_OUTPUT=true
            shift
            ;;
        -s|--session)
            if [ -n "${2:-}" ]; then
                SESSION_NAME="$2"
                shift 2
            else
                log_error "Option --session requires an argument."
                exit 1
            fi
            ;;
        -l|--layout)
            if [ -n "${2:-}" ]; then
                LAYOUT="$2"
                CUSTOM_LAYOUT_SET=true
                shift 2
            else
                log_error "Option --layout requires an argument."
                exit 1
            fi
            ;;
        -n|--new)
            FORCE_NEW=true
            shift
            ;;
        -k|--kill)
            KILL_SESSION=true
            shift
            ;;
        --list)
            LIST_SESSIONS=true
            shift
            ;;
        *)
            log_error "Unknown option: $1 (use --help for options)"
            exit 1
            ;;
    esac
done

resolve_layout_path

# Handle --list
if [ "$LIST_SESSIONS" = true ]; then
    if ! command -v zellij >/dev/null 2>&1; then
        log_error "zellij is not installed or not in PATH."
        exit 127
    fi
    exec zellij list-sessions
fi

# Handle --kill
if [ "$KILL_SESSION" = true ]; then
    if ! command -v zellij >/dev/null 2>&1; then
        log_error "zellij is not installed or not in PATH."
        exit 127
    fi
    log_info "Killing Zellij session '$SESSION_NAME'..."
    exec zellij kill-session "$SESSION_NAME"
fi

# Handle --status
if [ "$STATUS_CHECK" = true ]; then
    if is_session_running "$SESSION_NAME"; then
        if [ "$JSON_OUTPUT" = true ]; then
            printf '{"session":"%s","status":"running","running":true,"layout":"%s"}\n' "$SESSION_NAME" "$LAYOUT"
        else
            echo "Session '${SESSION_NAME}' is running."
        fi
        exit 0
    else
        if [ "$JSON_OUTPUT" = true ]; then
            printf '{"session":"%s","status":"stopped","running":false,"layout":"%s"}\n' "$SESSION_NAME" "$LAYOUT"
        else
            echo "Session '${SESSION_NAME}' is not running."
        fi
        exit 1
    fi
fi

# Determine whether to attach or launch new
SESSION_EXISTS=false
if is_session_running "$SESSION_NAME"; then
    SESSION_EXISTS=true
fi

if [ "$SESSION_EXISTS" = true ] && [ "$FORCE_NEW" = false ]; then
    ACTION="attach"
    CMD="zellij attach $SESSION_NAME"
else
    ACTION="launch"
    CMD="zellij --session $SESSION_NAME --layout $LAYOUT"
fi

# Handle --dry-run
if [ "$DRY_RUN" = true ]; then
    if [ "$JSON_OUTPUT" = true ]; then
        printf '{"dry_run":true,"session":"%s","layout":"%s","action":"%s","exists":%s,"command":"%s"}\n' \
            "$SESSION_NAME" "$LAYOUT" "$ACTION" "$SESSION_EXISTS" "$CMD"
    else
        echo "[dry-run] Session: '$SESSION_NAME'"
        echo "[dry-run] Layout:  '$LAYOUT'"
        echo "[dry-run] Action:  $ACTION"
        echo "[dry-run] Command: $CMD"
    fi
    exit 0
fi

# Execute launch or attach
if ! command -v zellij >/dev/null 2>&1; then
    log_error "'zellij' command not found in PATH. Please install zellij to run the terminal companion."
    exit 127
fi

if [ "$ACTION" = "attach" ]; then
    log_info "Attaching to active companion session '$SESSION_NAME'..."
    exec zellij attach "$SESSION_NAME"
else
    log_info "Launching new companion session '$SESSION_NAME' (layout: $LAYOUT)..."
    exec zellij --session "$SESSION_NAME" --layout "$LAYOUT"
fi
