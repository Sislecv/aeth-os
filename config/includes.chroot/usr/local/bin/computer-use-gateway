#!/usr/bin/env python3
"""
AgenticOS: Computer Use Gateway Daemon & CLI
Path: /usr/local/bin/computer-use-gateway
Description: Provides accessibility tree inspection (AT-SPI2), screen capture,
             and virtual mouse/keyboard input injection for Ghost Workspace (Workspace 2).
             Exposes CLI, HTTP REST / JSON-RPC 2.0, and local Unix Domain Socket.
"""

import sys
import os
import time
import json
import socket
import struct
import zlib
import shutil
import signal
import tempfile
import argparse
import threading
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler
from typing import Dict, Any, List, Optional, Tuple

GATEWAY_VERSION = "1.0.0"
DEFAULT_HTTP_HOST = "127.0.0.1"
DEFAULT_HTTP_PORT = 9888

# Determine default Unix Domain Socket path
def get_default_socket_path() -> str:
    uid = os.getuid()
    run_dir = f"/run/user/{uid}"
    if os.path.isdir(run_dir) and os.access(run_dir, os.W_OK):
        return os.path.join(run_dir, "computer-use-gateway.sock")
    return os.path.join(tempfile.gettempdir(), f"computer-use-gateway-{uid}.sock")

# ----------------------------------------------------------------------
# Fallback Mock PNG Generator (Pure Python, Zero External Dependencies)
# ----------------------------------------------------------------------
def generate_mock_png(width: int = 1920, height: int = 1080) -> bytes:
    """Generates a valid minimalist PNG image without requiring PIL or grim."""
    # Dark slate background (Material 3 style)
    r, g, b = 28, 33, 40
    raw_row = b"\x00" + bytes([r, g, b]) * width
    raw_data = raw_row * height
    compressed = zlib.compress(raw_data)
    png_data = (
        b"\x89PNG\r\n\x1a\n"
        + struct.pack(">I", 13)
        + b"IHDR"
        + struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
        + struct.pack(">I", zlib.crc32(b"IHDR" + struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        + struct.pack(">I", len(compressed))
        + b"IDAT"
        + compressed
        + struct.pack(">I", zlib.crc32(b"IDAT" + compressed))
        + struct.pack(">I", 0)
        + b"IEND"
        + struct.pack(">I", zlib.crc32(b"IEND"))
    )
    return png_data

# ----------------------------------------------------------------------
# 1. AT-SPI2 Accessibility Tree Inspector
# ----------------------------------------------------------------------
def dump_tree() -> Dict[str, Any]:
    """
    Parses AT-SPI2 accessibility tree and returns clean JSON tree with:
    id, role, name, states, and bounding_box [x, y, w, h].
    Falls back gracefully to mock tree if AT-SPI2 is unavailable.
    """
    # 1. Try pyatspi if installed and AT-SPI bus is responsive
    try:
        import pyatspi  # type: ignore
        registry = pyatspi.Registry
        desktop = registry.getDesktop(0)
        if desktop and desktop.childCount > 0:
            return _parse_pyatspi_node(desktop, "root")
    except Exception:
        pass

    # 2. Try querying via AT-SPI D-Bus interface if available
    dbus_tree = _query_atspi_dbus()
    if dbus_tree:
        return dbus_tree

    # 3. Fallback to realistic mock tree (Headless / Testing environment)
    return _generate_mock_tree()

def _parse_pyatspi_node(acc, path: str = "0") -> Dict[str, Any]:
    """Helper to convert pyatspi Accessible into clean JSON structure."""
    role_name = "unknown"
    try:
        role_name = acc.get_role_name()
    except Exception:
        pass

    name = ""
    try:
        name = acc.name or ""
    except Exception:
        pass

    states: List[str] = []
    try:
        state_set = acc.get_state_set()
        states = [s.value_name for s in state_set.get_states()]
    except Exception:
        pass

    bbox = [0, 0, 0, 0]
    try:
        import pyatspi  # type: ignore
        comp = acc.queryComponent()
        rect = comp.getExtents(pyatspi.DESKTOP_COORDS)
        bbox = [int(rect.x), int(rect.y), int(rect.width), int(rect.height)]
    except Exception:
        pass

    children: List[Dict[str, Any]] = []
    try:
        for idx in range(acc.childCount):
            child = acc.getChildAtIndex(idx)
            if child is not None:
                children.append(_parse_pyatspi_node(child, f"{path}_{idx}"))
    except Exception:
        pass

    return {
        "id": f"elem_{path}",
        "role": role_name,
        "name": name,
        "states": states,
        "bounding_box": bbox,
        "children": children,
    }

def _query_atspi_dbus() -> Optional[Dict[str, Any]]:
    """Attempts direct query over session D-Bus for org.a11y.Bus / Introspect."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return None
    if not shutil.which("gdbus"):
        return None
    try:
        # Check if org.a11y.Bus is available
        res = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
             "--object-path", "/org/freedesktop/DBus", "--method", "org.freedesktop.DBus.ListNames"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=2
        )
        if "org.a11y.Bus" not in res.stdout:
            return None
    except Exception:
        return None
    return None

