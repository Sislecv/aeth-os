def find_node_by_id(node: Dict[str, Any], target_id: str) -> Optional[Dict[str, Any]]:
    """Recursively searches accessibility tree for node matching ID or name."""
    if node.get("id") == target_id or node.get("name") == target_id:
        return node
    for child in node.get("children", []):
        res = find_node_by_id(child, target_id)
        if res:
            return res
    return None

# ----------------------------------------------------------------------
# 2. Virtual Mouse Input Injection
# ----------------------------------------------------------------------
def click_coords(x: int, y: int, button: str = "left", double: bool = False) -> Dict[str, Any]:
    """
    Injects mouse click via ydotool / libei / wtype / xdotool.
    Falls back to mock event recording if running headless.
    """
    backend = "mock"
    executed = False

    # Check ydotool (Wayland standard)
    if shutil.which("ydotool"):
        try:
            subprocess.run(["ydotool", "mousemove", "-a", str(x), str(y)],
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            btn_hex = "0xC0" if button == "left" else ("0xC1" if button == "right" else "0xC2")
            subprocess.run(["ydotool", "click", btn_hex],
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            if double:
                time.sleep(0.08)
                subprocess.run(["ydotool", "click", btn_hex],
                               check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            backend = "ydotool"
            executed = True
        except Exception:
            pass

    # Check xdotool (Xwayland / X11 fallback)
    if not executed and shutil.which("xdotool") and os.environ.get("DISPLAY"):
        try:
            btn_idx = "1" if button == "left" else ("3" if button == "right" else "2")
            args = ["xdotool", "mousemove", str(x), str(y), "click"]
            if double:
                args.extend(["--repeat", "2", "--delay", "80"])
            args.append(btn_idx)
            subprocess.run(args, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            backend = "xdotool"
            executed = True
        except Exception:
            pass

    return {
        "status": "ok",
        "action": "click_coords",
        "coords": [int(x), int(y)],
        "button": button,
        "double": bool(double),
        "backend": backend,
        "executed": executed,
    }

def click_element(element_id: str, button: str = "left", double: bool = False) -> Dict[str, Any]:
    """Locates element by ID in AT-SPI2 tree and clicks its center bounding box."""
    tree = dump_tree()
    node = find_node_by_id(tree, element_id)
    if not node:
        return {
            "status": "error",
            "action": "click_element",
            "element_id": element_id,
            "message": f"Element '{element_id}' not found in accessibility tree",
        }
    bbox = node.get("bounding_box", [0, 0, 0, 0])
    x, y, w, h = bbox
    cx = x + max(w // 2, 0)
    cy = y + max(h // 2, 0)
    click_res = click_coords(cx, cy, button=button, double=double)
    click_res.update({
        "action": "click_element",
        "element_id": element_id,
        "target_name": node.get("name"),
        "target_role": node.get("role"),
        "target_bbox": bbox,
    })
    return click_res

# ----------------------------------------------------------------------
# 3. Virtual Keyboard Input Injection
# ----------------------------------------------------------------------
def type_text(text: str = "", hotkey: Optional[str] = None) -> Dict[str, Any]:
    """
    Injects keystrokes or text string via wtype / ydotool / xdotool.
    """
    backend = "mock"
    executed = False

    # Hotkey injection
    if hotkey:
        if shutil.which("wtype"):
            try:
                # wtype hotkey handling
                parts = hotkey.replace("-", "+").split("+")
                modifiers = [p.lower() for p in parts[:-1]]
                key = parts[-1]
                cmd = ["wtype"]
                for m in modifiers:
                    cmd.extend(["-M", m])
                cmd.extend(["-k", key])
                for m in reversed(modifiers):
                    cmd.extend(["-m", m])
                subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "wtype"
                executed = True
            except Exception:
                pass
        elif shutil.which("ydotool"):
            try:
                subprocess.run(["ydotool", "key", hotkey], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "ydotool"
                executed = True
            except Exception:
                pass
        elif shutil.which("xdotool") and os.environ.get("DISPLAY"):
            try:
                subprocess.run(["xdotool", "key", hotkey], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "xdotool"
                executed = True
            except Exception:
                pass

    # Text injection
    if text:
        if shutil.which("wtype"):
            try:
                subprocess.run(["wtype", "--", text], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "wtype"
                executed = True
            except Exception:
                pass
        elif shutil.which("ydotool"):
            try:
                subprocess.run(["ydotool", "type", "--", text], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "ydotool"
                executed = True
            except Exception:
                pass
        elif shutil.which("xdotool") and os.environ.get("DISPLAY"):
            try:
                subprocess.run(["xdotool", "type", "--", text], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                backend = "xdotool"
                executed = True
            except Exception:
                pass

    return {
        "status": "ok",
        "action": "type_text",
        "text": text,
        "hotkey": hotkey,
        "backend": backend,
        "executed": executed,
    }

# ----------------------------------------------------------------------
# 4. Screen Capture (Screenshot)
# ----------------------------------------------------------------------
def capture_screenshot(output_path: Optional[str] = None) -> Dict[str, Any]:
    """
    Captures screen using grim / gnome-screenshot / Mutter ScreenCast,
    or pure-Python fallback if headless.
    """
    if not output_path:
        uid = os.getuid()
        base_dir = f"/run/user/{uid}" if os.path.isdir(f"/run/user/{uid}") else tempfile.gettempdir()
        output_path = os.path.join(base_dir, f"gateway_screenshot_{int(time.time() * 1000)}.png")

    backend = "mock_png"
    captured = False

    # 1. Try grim (Wayland)
    if shutil.which("grim") and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_RUNTIME_DIR")):
        try:
            subprocess.run(["grim", output_path], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            backend = "grim"
            captured = True
        except Exception:
            pass

    # 2. Try gnome-screenshot
    if not captured and shutil.which("gnome-screenshot") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        try:
            subprocess.run(["gnome-screenshot", "-f", output_path], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            backend = "gnome-screenshot"
            captured = True
        except Exception:
            pass

    # 3. Try import (ImageMagick)
    if not captured and shutil.which("import") and os.environ.get("DISPLAY"):
        try:
            subprocess.run(["import", "-window", "root", output_path], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            backend = "imagemagick"
            captured = True
        except Exception:
            pass

    # 4. Fallback: generate valid mock PNG file
    if not captured:
        png_bytes = generate_mock_png(1920, 1080)
        os.makedirs(os.path.dirname(os.path.abspath(output_path)), exist_ok=True)
        with open(output_path, "wb") as f:
            f.write(png_bytes)
        backend = "pure_python_mock"
        captured = True

    file_size = os.path.getsize(output_path) if os.path.exists(output_path) else 0

    return {
        "status": "ok",
        "action": "screenshot",
        "path": os.path.abspath(output_path),
        "size": [1920, 1080],
        "file_bytes": file_size,
        "backend": backend,
        "captured": captured,
    }

# ----------------------------------------------------------------------
# 5. Status & Diagnostics
# ----------------------------------------------------------------------
def get_status() -> Dict[str, Any]:
    """Returns gateway status, environment diagnostics, and backend capabilities."""
    has_pyatspi = False
    try:
        import pyatspi  # type: ignore
        has_pyatspi = True
    except ImportError:
        pass

    return {
        "status": "running",
        "version": GATEWAY_VERSION,
        "environment": {
            "display": os.environ.get("DISPLAY", ""),
            "wayland_display": os.environ.get("WAYLAND_DISPLAY", ""),
            "xdg_runtime_dir": os.environ.get("XDG_RUNTIME_DIR", ""),
            "session_bus": bool(os.environ.get("DBUS_SESSION_BUS_ADDRESS")),
        },
        "backends": {
            "pyatspi": has_pyatspi,
            "ydotool": bool(shutil.which("ydotool")),
            "wtype": bool(shutil.which("wtype")),
            "xdotool": bool(shutil.which("xdotool")),
            "grim": bool(shutil.which("grim")),
            "gnome_screenshot": bool(shutil.which("gnome-screenshot")),
        },
        "default_socket": get_default_socket_path(),
        "default_http_port": DEFAULT_HTTP_PORT,
    }

# ----------------------------------------------------------------------
# 6. Unified Request Dispatcher (CLI / RPC / REST)
# ----------------------------------------------------------------------
def dispatch_request(method: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """Dispatches a method call to corresponding gateway handler."""
    params = params or {}
    method_norm = method.lower().replace("-", "_")

    if method_norm in ("dump_tree", "inspect_tree", "tree"):
        return dump_tree()
    elif method_norm in ("click_coords", "click"):
        coords = params.get("coords")
        if coords and isinstance(coords, (list, tuple)) and len(coords) >= 2:
            x, y = coords[0], coords[1]
        else:
            x = params.get("x", 0)
            y = params.get("y", 0)
        btn = params.get("button", "left")
        dbl = params.get("double", False)
        return click_coords(int(x), int(y), button=btn, double=bool(dbl))
    elif method_norm in ("click_element", "click_elem"):
        elem_id = params.get("id") or params.get("element_id") or ""
        btn = params.get("button", "left")
        dbl = params.get("double", False)
        return click_element(str(elem_id), button=btn, double=bool(dbl))
    elif method_norm in ("type_text", "type"):
        text = params.get("text", "")
        hotkey = params.get("hotkey")
        return type_text(text=str(text), hotkey=hotkey)
    elif method_norm in ("capture_screenshot", "screenshot"):
        out_path = params.get("output_path") or params.get("path")
        return capture_screenshot(out_path)
    elif method_norm in ("get_status", "status"):
        return get_status()
    else:
        return {
            "status": "error",
            "message": f"Unknown method '{method}'",
            "supported_methods": [
                "dump_tree",
                "click_coords",
                "click_element",
                "type_text",
                "capture_screenshot",
                "get_status",
            ],
        }

# ----------------------------------------------------------------------
# 7. Persistent Daemon (HTTP REST / JSON-RPC + Unix Domain Socket)
# ----------------------------------------------------------------------
class GatewayHTTPHandler(BaseHTTPRequestHandler):
    """Handles HTTP REST and JSON-RPC 2.0 requests."""

    def log_message(self, format: str, *args: Any) -> None:
        # Suppress normal request logging to keep service logs concise
        pass

    def _send_json(self, status_code: int, data: Any) -> None:
        body = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self) -> None:
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self) -> None:
        path = self.path.split("?")[0].rstrip("/")
        if path in ("", "/status"):
            self._send_json(200, get_status())
        elif path in ("/tree", "/dump_tree", "/inspect_tree"):
            self._send_json(200, dump_tree())
        elif path == "/screenshot":
            res = capture_screenshot()
            self._send_json(200, res)
        elif path == "/screenshot/raw":
            res = capture_screenshot()
            shot_path = res["path"]
            if os.path.exists(shot_path):
                with open(shot_path, "rb") as f:
                    content = f.read()
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", str(len(content)))
                self.end_headers()
                self.wfile.write(content)
            else:
                self._send_json(404, {"status": "error", "message": "Screenshot not found"})
        else:
            self._send_json(404, {"status": "error", "message": f"Endpoint '{path}' not found"})

    def do_POST(self) -> None:
        content_length = int(self.headers.get("Content-Length", 0))
        raw_body = self.rfile.read(content_length).decode("utf-8") if content_length > 0 else "{}"
        try:
            body = json.loads(raw_body) if raw_body else {}
        except json.JSONDecodeError:
            self._send_json(400, {"status": "error", "message": "Invalid JSON payload"})
            return

        path = self.path.split("?")[0].rstrip("/")

        # Standard JSON-RPC 2.0 endpoint: /rpc or /
        if path in ("/rpc", "/api/rpc", "") and "method" in body:
            req_id = body.get("id")
            method = body.get("method", "")
            params = body.get("params", {})
            if isinstance(params, list):
                # Map array params to dictionary
                params_dict = {}
                if len(params) > 0:
                    params_dict["param0"] = params[0]
                params = params_dict

            result = dispatch_request(method, params)
            response = {
                "jsonrpc": "2.0",
                "id": req_id,
            }
            if result.get("status") == "error":
                response["error"] = {"code": -32601, "message": result.get("message", "Error")}
            else:
                response["result"] = result
            self._send_json(200, response)
            return

        # REST style endpoints
        if path in ("/tree", "/inspect_tree", "/dump_tree"):
            self._send_json(200, dump_tree())
        elif path in ("/click", "/click_coords"):
            self._send_json(200, dispatch_request("click_coords", body))
        elif path in ("/click_element", "/click_elem"):
            self._send_json(200, dispatch_request("click_element", body))
        elif path in ("/type", "/type_text"):
            self._send_json(200, dispatch_request("type_text", body))
        elif path in ("/screenshot", "/capture_screenshot"):
            self._send_json(200, dispatch_request("capture_screenshot", body))
        elif path == "/status":
            self._send_json(200, get_status())
        else:
            self._send_json(404, {"status": "error", "message": f"Unknown endpoint '{path}'"})

class GatewayDaemon:
    """Manages concurrent HTTP server and Unix Domain Socket listeners."""

    def __init__(self, host: str = DEFAULT_HTTP_HOST, port: int = DEFAULT_HTTP_PORT, socket_path: Optional[str] = None):
        self.host = host
        self.port = port
        self.socket_path = socket_path or get_default_socket_path()
        self.httpd: Optional[HTTPServer] = None
        self.unix_sock: Optional[socket.socket] = None
        self.running = False
        self.threads: List[threading.Thread] = []

    def start(self) -> None:
        self.running = True

        # 1. Start Unix Domain Socket listener
        try:
            if os.path.exists(self.socket_path):
                try:
                    os.unlink(self.socket_path)
                except OSError:
                    pass
            sock_dir = os.path.dirname(os.path.abspath(self.socket_path))
            os.makedirs(sock_dir, exist_ok=True)
            self.unix_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.unix_sock.bind(self.socket_path)
            os.chmod(self.socket_path, 0o600)
            self.unix_sock.listen(10)
            t_unix = threading.Thread(target=self._run_unix_socket, daemon=True, name="UnixSocketServer")
            t_unix.start()
            self.threads.append(t_unix)
            print(f"[computer-use-gateway] Unix Socket active: {self.socket_path}", file=sys.stderr)
        except Exception as e:
            print(f"[computer-use-gateway] Warning: Failed to bind Unix socket ({e})", file=sys.stderr)

        # 2. Start HTTP server
        try:
            self.httpd = HTTPServer((self.host, self.port), GatewayHTTPHandler)
            t_http = threading.Thread(target=self.httpd.serve_forever, daemon=True, name="HTTPServer")
            t_http.start()
            self.threads.append(t_http)
            print(f"[computer-use-gateway] HTTP JSON-RPC active: http://{self.host}:{self.port}", file=sys.stderr)
        except Exception as e:
            print(f"[computer-use-gateway] Warning: Failed to bind HTTP server ({e})", file=sys.stderr)

    def _run_unix_socket(self) -> None:
        while self.running and self.unix_sock:
            try:
                conn, _ = self.unix_sock.accept()
                threading.Thread(target=self._handle_unix_conn, args=(conn,), daemon=True).start()
            except Exception:
                if not self.running:
                    break

    def _handle_unix_conn(self, conn: socket.socket) -> None:
        with conn:
            try:
                conn.settimeout(5.0)
                data = conn.recv(65536).decode("utf-8").strip()
                if not data:
                    return

                # Handle HTTP over unix socket or line JSON
                if data.startswith("GET ") or data.startswith("POST "):
                    lines = data.split("\r\n")
                    req_line = lines[0].split(" ")
                    method = req_line[0]
                    path = req_line[1] if len(req_line) > 1 else "/"
                    body_json = {}
                    if "\r\n\r\n" in data:
                        body_str = data.split("\r\n\r\n", 1)[1]
                        try:
                            body_json = json.loads(body_str)
                        except Exception:
                            pass
                    if method == "GET" and path in ("/status", "/"):
                        res_data = get_status()
                    elif method in ("GET", "POST") and path in ("/tree", "/dump_tree"):
                        res_data = dump_tree()
                    else:
                        res_data = dispatch_request(path.strip("/"), body_json)
                    payload = json.dumps(res_data).encode("utf-8")
                    resp = (
                        b"HTTP/1.1 200 OK\r\n"
                        b"Content-Type: application/json\r\n"
                        b"Content-Length: " + str(len(payload)).encode("utf-8") + b"\r\n\r\n" + payload
                    )
                    conn.sendall(resp)
                    return

                # Line JSON-RPC / Action format
                req = json.loads(data)
                req_id = req.get("id")
                method = req.get("method") or req.get("action", "")
                params = req.get("params", {})
                res = dispatch_request(method, params)

                if "jsonrpc" in req or req_id is not None:
                    res_body = {
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": res,
                    }
                else:
                    res_body = res
                conn.sendall((json.dumps(res_body) + "\n").encode("utf-8"))
            except Exception as e:
                err_resp = json.dumps({"status": "error", "message": str(e)}) + "\n"
                try:
                    conn.sendall(err_resp.encode("utf-8"))
                except Exception:
                    pass

    def stop(self) -> None:
        self.running = False
        if self.httpd:
            try:
                self.httpd.shutdown()
                self.httpd.server_close()
            except Exception:
                pass
        if self.unix_sock:
            try:
                self.unix_sock.close()
            except Exception:
                pass
            if os.path.exists(self.socket_path):
                try:
                    os.unlink(self.socket_path)
                except OSError:
                    pass

# ----------------------------------------------------------------------
# 8. CLI Interface & Main Entrypoint
# ----------------------------------------------------------------------
def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="AgenticOS Computer Use Gateway: AT-SPI2 Accessibility & Input Daemon",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  computer-use-gateway --dump-tree
  computer-use-gateway --click 640,480
  computer-use-gateway --click-element btn_search
  computer-use-gateway --type "Hello AgenticOS" --hotkey Return
  computer-use-gateway --screenshot /tmp/screen.png
  computer-use-gateway --status
  computer-use-gateway --serve --port 9888
        """,
    )

    parser.add_argument("--dump-tree", action="store_true", help="Dump accessibility widget tree as JSON")
    parser.add_argument("--click", metavar="X,Y", help="Click at specified coordinates (e.g. 100,200)")
    parser.add_argument("--click-element", metavar="ID", help="Click center of element with specified accessibility ID")
    parser.add_argument("--type", dest="type_text", metavar="TEXT", help="Type text string into active window")
    parser.add_argument("--hotkey", metavar="KEY", help="Send hotkey combination (e.g. Return, Ctrl+C, Super+F11)")
    parser.add_argument("--screenshot", nargs="?", const="DEFAULT", metavar="PATH", help="Capture screen to file (default auto path)")
    parser.add_argument("--status", action="store_true", help="Show gateway status, display info, and backend backstops")
    parser.add_argument("--serve", action="store_true", help="Start persistent HTTP & Unix socket daemon")
    parser.add_argument("--host", default=DEFAULT_HTTP_HOST, help=f"Daemon HTTP bind host (default: {DEFAULT_HTTP_HOST})")
    parser.add_argument("--port", type=int, default=DEFAULT_HTTP_PORT, help=f"Daemon HTTP bind port (default: {DEFAULT_HTTP_PORT})")
    parser.add_argument("--socket", default=None, help="Daemon Unix domain socket path")
    parser.add_argument("--pretty", action="store_true", help="Format JSON output with indentation")

    return parser.parse_args()

def main() -> int:
    args = parse_args()
    indent = 2 if args.pretty or not sys.stdout.isatty() else 2

    if args.status:
        status_info = get_status()
        print(json.dumps(status_info, indent=indent))
        return 0

    if args.dump_tree:
        tree = dump_tree()
        print(json.dumps(tree, indent=indent))
        return 0

    if args.click:
        parts = args.click.split(",")
        if len(parts) != 2:
            print(json.dumps({"status": "error", "message": "Click format must be X,Y (e.g. 500,300)"}), file=sys.stderr)
            return 1
        try:
            x, y = int(parts[0].strip()), int(parts[1].strip())
            res = click_coords(x, y)
            print(json.dumps(res, indent=indent))
            return 0
        except ValueError:
            print(json.dumps({"status": "error", "message": "Invalid coordinate integers"}), file=sys.stderr)
            return 1

    if args.click_element:
        res = click_element(args.click_element)
        print(json.dumps(res, indent=indent))
        return 0 if res.get("status") == "ok" else 1

    if args.type_text or args.hotkey:
        res = type_text(text=args.type_text or "", hotkey=args.hotkey)
        print(json.dumps(res, indent=indent))
        return 0

    if args.screenshot is not None:
        target_path = None if args.screenshot == "DEFAULT" else args.screenshot
        res = capture_screenshot(target_path)
        print(json.dumps(res, indent=indent))
        return 0

    if args.serve:
        daemon = GatewayDaemon(host=args.host, port=args.port, socket_path=args.socket)

        def sig_handler(signum, frame):
            print("\n[computer-use-gateway] Received termination signal, shutting down...", file=sys.stderr)
            daemon.stop()
            sys.exit(0)

        signal.signal(signal.SIGINT, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)

        daemon.start()
        print(f"[computer-use-gateway] Gateway service daemon initialized and ready.", file=sys.stderr)

        # Keep main thread alive
        try:
            while daemon.running:
                time.sleep(1)
        except (KeyboardInterrupt, SystemExit):
            pass
        finally:
            daemon.stop()
        return 0

    # Default if no arguments specified: show help
    parse_args_parser = argparse.ArgumentParser()
    args_list = sys.argv[1:]
    if not args_list:
        subprocess.run([sys.executable, sys.argv[0], "--help"])
        return 0

    return 0

if __name__ == "__main__":
    sys.exit(main())
