[Unit]
Description=AgenticOS Computer Use Gateway Service
Documentation=man:computer-use-gateway(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/computer-use-gateway --serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
