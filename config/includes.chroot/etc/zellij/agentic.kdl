// Agentic OS - Zellij 65:35 Terminal Companion Layout
// Architecture:
// - Left Pane (65%): Main interactive user shell (Bash / Zsh)
// - Right Pane (35%): Dedicated Pi Agent companion session with graceful fallback
// - Bottom status-bar: Visual shortcuts for quick actions
//   [Alt+A: Send Command] [Alt+B: Send Logs] [Alt+C: Ghost Computer Use] [F5: Voice Input]

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true name="status-bar" command="bash" {
            args "-c" "printf '\033[1;36m[Alt+A: Send Command]\033[0m  \033[1;32m[Alt+B: Send Logs]\033[0m  \033[1;35m[Alt+C: Ghost Computer Use]\033[0m  \033[1;33m[F5: Voice Input]\033[0m\n'; exec sleep infinity"
        }
    }
    tab name="Agentic" focus=true {
        pane split_direction="vertical" {
            pane size="65%" name="terminal" focus=true
            pane size="35%" name="pi" command="bash" {
                args "-c" "if command -v pi >/dev/null 2>&1; then exec pi; else echo 'pi command not found, falling back to bash...'; exec bash; fi"
            }
        }
    }
}
